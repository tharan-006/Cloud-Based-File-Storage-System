# ========================================================
# Cloud-Based File Storage System - Environment Configuration
# ========================================================

FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=cloud-storage-secret-key-2026-academic-key-10938

# Storage Backend Mode: 'local' (prototype) or 's3' (AWS S3 Cloud Storage)
STORAGE_BACKEND=local

# User Storage Quota (in Megabytes)
USER_STORAGE_QUOTA_MB=100

# Maximum Allowed Upload Size Per Single File (in Megabytes)
MAX_CONTENT_LENGTH_MB=25

# --------------------------------------------------------
# AWS S3 Cloud Storage Configuration
# (Required only if STORAGE_BACKEND=s3)
# --------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=us-east-1
