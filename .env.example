# ========================================================
# Cloud-Based File Storage System - Environment Configuration
# ========================================================

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Storage Backend Mode: 'local' (default prototype) or 's3' (AWS Cloud Storage)
STORAGE_BACKEND=local

# User Storage Quota (in Megabytes)
USER_STORAGE_QUOTA_MB=100

# Maximum Allowed Upload Size Per Single File (in Megabytes)
MAX_CONTENT_LENGTH_MB=25

# --------------------------------------------------------
# AWS S3 Cloud Storage Configuration
# (Required only if STORAGE_BACKEND=s3)
# --------------------------------------------------------
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_BUCKET_NAME=your_unique_s3_bucket_name
AWS_REGION=us-east-1
